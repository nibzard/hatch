  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hatch/agent": "workspace:*",
    "@hatch/core": "workspace:*",
    "@hatch/geometry": "workspace:*",
    "@hatch/hatching": "workspace:*",
    "@hatch/objects": "workspace:*",
    "@hatch/styles": "workspace:*"
  }
}
