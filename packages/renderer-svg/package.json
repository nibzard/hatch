{
  "name": "@hatch/renderer-svg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVG output: paths, patterns, strokes, debug layers, and metadata.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
